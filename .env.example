# Select the active text-generation provider: groq or gemini.
LLM_PROVIDER=groq

# Existing backend/database configuration (replace with your private values).
DATABASE_URL=postgresql+psycopg://db_user:replace_with_password@localhost:5434/db_name
POSTGRES_PASSWORD=replace_with_postgres_password

# Groq (active default)
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_TIMEOUT_SECONDS=45
GROQ_MAX_OUTPUT_TOKENS=2048
GROQ_MAX_RETRIES=1

# Optional Gemini provider (select with LLM_PROVIDER=gemini)
GEMINI_API_KEY=replace_with_your_gemini_api_key
GEMINI_TIMEOUT_MS=30000
