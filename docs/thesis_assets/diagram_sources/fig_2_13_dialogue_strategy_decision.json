      "id": "r1",
      "label": "1. emotion frustrated? → acknowledge_frustration"
    },
    {
      "id": "r2",
      "label": "2. hesitation ≥ .7 AND confidence ≤ .45? → reassure"
    },
    {
      "id": "r3",
      "label": "3. overloaded_uncertain AND confidence ≤ .35? → simplify"
    },
    {
      "id": "r4",
      "label": "4. interaction overloaded/overloaded_uncertain AND load ≥ .9? → reduce_information"
    },
    {
      "id": "r5",
      "label": "5. hesitation ≥ .7? → slow_down"
    },
    {
      "id": "r6",
      "label": "6. interaction overloaded? → simplify"
    },
    {
      "id": "r7",
      "label": "7. interaction struggling? → clarify"
    },
    {
      "id": "r8",
      "label": "8. interaction disengaged? → re_engage"
    },
    {
      "id": "r9",
      "label": "9. confident_engaged? → continue"
    },
    {
      "id": "r10",
      "label": "10. needs_clarification? uncertain → ask_follow_up; else clarify"
    },
    {
      "id": "r11",
      "label": "11. needs_encouragement? → encourage"
    },
    {
      "id": "r12",
      "label": "12. otherwise → normal_response"
    },
    {
      "id": "caveat",
      "label": "Precedence ordered; frustrated/uncertain labels are not emitted by current audio emotion detector"
    }
