# Frontend environment variables. Copy this file to .env.local as needed.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Optional. When omitted, the WebSocket URL is derived from
# VITE_API_BASE_URL (including http -> ws and https -> wss conversion).
# VITE_WS_BASE_URL=ws://localhost:8000

VITE_AUDIO_UPLOAD_TIMEOUT_MS=180000
